# Скопируйте этот файл в `.env` рядом с seminar.ipynb и заполните значения.
# Ноутбук читает `.env` через python-dotenv и не печатает секреты.

# Нужен, только если RUN_LIVE_OPENROUTER = True
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-8b

# Нужен, только если RUN_YATASKS = True
YATASKS_TOKEN=

# Необязателен для публичных моделей Hugging Face
HF_TOKEN=
